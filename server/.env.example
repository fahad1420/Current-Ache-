# ==========================================
# SERVER ENVIRONMENT CONFIGURATION (.env)
# ==========================================
PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (Required in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/electricity_status_bd?retryWrites=true&w=majority

# Frontend URL (For CORS whitelist)
CLIENT_URL=https://your-frontend-project.vercel.app

# Cryptographic Keys (Required in production - use strong random strings)
JWT_SECRET=your_long_random_jwt_secret_key_here
IP_SALT=your_unique_random_salt_for_ip_hashing

# Admin Credentials (Required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!
